<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_options_format"
            android:textColor="@color/nevus_ink"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/formatGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/formatVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/download_options_format_video" />

            <RadioButton
                android:id="@+id/formatAudioOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/download_options_format_audio_only" />
        </RadioGroup>

        <TextView
            android:id="@+id/sourceQualityLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_options_source_quality"
            android:textColor="@color/nevus_ink"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/sourceQualitySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_options_target_resolution"
            android:textColor="@color/nevus_ink"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/dialogTargetHeightGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/dialogHeightAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/height_auto" />
            <RadioButton
                android:id="@+id/dialogHeight720"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/height_720p" />
            <RadioButton
                android:id="@+id/dialogHeight1080"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/height_1080p" />
            <RadioButton
                android:id="@+id/dialogHeight1440"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/height_1440p" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/enhanceCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_options_enhance" />

    </LinearLayout>
</ScrollView>
