# Store large binary artifacts in Git LFS so the working tree stays lean.
# (*.zip excluded — account LFS budget exhausted; committed as regular blob.)
*.apk filter=lfs diff=lfs merge=lfs -text
*.aab filter=lfs diff=lfs merge=lfs -text
*.jar filter=lfs diff=lfs merge=lfs -text
*.so  filter=lfs diff=lfs merge=lfs -text
*.zip !text !filter !merge !diff
